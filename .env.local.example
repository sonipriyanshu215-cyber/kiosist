# Copy this file to .env.local and fill in values

# Email delivery (Resend- resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email destination(s) for contact-form inquiries- comma-separated, all sent
# in one Resend call.
NOTIFY_EMAILS=hr@kiosist.com,someone-else@kiosist.com

# Shared secret for the Cognito Forms webhook (app/api/webhooks/cognito-forms).
# Generate one (same method as SESSION_SECRET below) and paste it into that
# form's "Submit Entry Endpoint" URL as a query param:
#   https://kiosist.com/api/webhooks/cognito-forms?token=<this value>
# Requests without a matching ?token= are rejected- Cognito Forms doesn't
# sign or authenticate its webhook calls on its own.
COGNITO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Career applications submit straight to Cognito Forms (see
# components/career/CognitoFormEmbed.tsx)- Cognito emails NOTIFY_EMAILS
# itself (configured in the Cognito Forms dashboard, not this app). The
# webhook above only mirrors each submission into this app's own
# Admin -> Inquiries. HR_EMAIL/HIRING_EMAIL/HIRING_EMAIL_2/CONTACT_EMAIL
# (singular) were the old per-flow vars, replaced by NOTIFY_EMAILS above-
# and the old /api/careers route (removed 2026-09-04) is gone.

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL (used in sitemap + OG)
NEXT_PUBLIC_SITE_URL=https://kiosist.com

# Supabase (Project Settings -> API in the Supabase dashboard)
# SUPABASE_SERVICE_ROLE_KEY is server-only- never expose it to the client.
#
# EVERY environment that runs this app- each developer's machine AND the
# deployed site- must point at the SAME Supabase project with these exact
# values. .env.local is gitignored, so a fresh clone has no backend: the
# public site quietly falls back to the bundled default images/content and
# /admin can't be used. Admin-uploaded images live in Supabase Storage, so
# they only appear on other machines once those machines share this config.
#
# The `media` Storage bucket MUST be marked Public (Storage -> media ->
# ... -> Make public), or the image URLs 404 for everyone. `resumes` stays
# private. See supabase/schema.sql for the full one-time setup.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin panel (/admin)
ADMIN_PASSWORD=change-me
# 32+ byte random string used to sign admin session cookies, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
